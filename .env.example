# Admin
ADMIN_PASSWORD=

# Copilot (server-side only — never put these in HTML/JS)
ANTHROPIC_API_KEY=
# Optional override of the model constant in lib/copilot-config.js
ANTHROPIC_MODEL=claude-sonnet-5-5
COPILOT_MAX_STEPS=8
COPILOT_TIMEOUT_MS=45000
COPILOT_DAILY_BUDGET_CAP=50
COPILOT_TOTAL_BUDGET_CAP=500
COPILOT_ALERTS=on
CRON_SECRET=

# Meta Ads (optional). Without these, Copilot fills drafts locally.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Existing platform
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
STRIPE_SECRET_KEY=
SQUARE_ACCESS_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
EMAIL_FROM=
MERCHANT_EMAIL=
